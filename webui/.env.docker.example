# Iris WebUI — Docker deployment template.
#
# Quickstart: `cp .env.docker.example .env` then `docker compose up -d`.
# Secrets belong here; behavioural settings belong in ~/.iris/config.yaml.

# ── UID / GID alignment ───────────────────────────────────────────────────
# The agent and webui containers must agree on UID/GID so bind-mounted files
# stay readable. All compose files resolve the same ${UID}/${GID} source.
UID=1000
GID=1000

# ── Paths ─────────────────────────────────────────────────────────────────
# Host-side Iris home (state, config, credentials). Mounted into the
# container; the single-container image seeds /app from the build context.
IRIS_HOME=./.iris
# Workspace the agent works in. Bind-mounted so edits survive container
# recreation.
IRIS_WORKSPACE=./workspace

# ── WebUI auth ────────────────────────────────────────────────────────────
# Required: the WebUI refuses to start without a password unless it is bound
# to loopback with auth disabled.
IRIS_WEBUI_PASSWORD=change-me

# ── Agent API server ──────────────────────────────────────────────────────
# The agent's API server needs a usable API_SERVER_KEY of at least >=16 chars;
# shorter keys are silently ignored by the agent. The WebUI forwards the same
# value automatically as IRIS_WEBUI_GATEWAY_API_KEY, so set it once here.
API_SERVER_KEY=change-me-to-a-long-random-string
# IRIS_WEBUI_GATEWAY_API_KEY is derived from API_SERVER_KEY and forwarded
# automatically — you normally do not set it by hand.

# ── Bind-mount permission escape hatches ──────────────────────────────────
# Set IRIS_SKIP_CHMOD=1 when your host UID cannot chmod the mounted home
# (containers running as a mismatched user). Skip the chmod pass entirely.
IRIS_SKIP_CHMOD=0
# IRIS_HOME_MODE overrides the created-home permissions.
#
# MULTI-CONTAINER WARNING: IRIS_HOME_MODE means different things per service.
#   - WebUI: a credential-FILE threshold (0640 = allow group bits).
#   - Agent: a DIRECTORY mode (default 0700). A mode without owner-execute
#     (e.g. 0640) has no owner-execute bit for a directory, so the agent cannot
#     traverse its own home and bricks. Use 0750 or 0701 for the agent.
# Copying the WebUI's 0640 value into the agent service is a known footgun.
IRIS_HOME_MODE=0700
