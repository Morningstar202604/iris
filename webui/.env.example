# Iris WebUI environment template.
#
# Copy to .env (never commit the real file) and uncomment what you need.
# Secrets belong here; behavioural settings belong in ~/.hermes/config.yaml.

# ── Server ────────────────────────────────────────────────────────────────
# HERMES_WEBUI_HOST=127.0.0.1
# HERMES_WEBUI_PORT=8787
# HERMES_WEBUI_PASSWORD=change-me

# ── Sidebar recency window ────────────────────────────────────────────────
# Size of the sidebar's interactive recency window; also bounds how many
# delegated subagent children can nest at once. Non-integer or non-positive
# values fall back to the default (20). Values above 200 are clamped.
# HERMES_WEBUI_VISIBLE_SESSION_LIMIT=20

# ── Agent / gateway ───────────────────────────────────────────────────────
# HERMES_HOME=~/.hermes
# HERMES_WEBUI_DEFAULT_WORKSPACE=~/workspace
# HERMES_API_URL=http://127.0.0.1:8642
# HERMES_WEBUI_GATEWAY_BASE_URL=http://127.0.0.1:8642
# GATEWAY_HEALTH_URL=http://127.0.0.1:8642/health
