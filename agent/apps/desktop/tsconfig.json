{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["node"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@iris/plugin-sdk": ["./src/sdk/index.ts"],
      "@iris/shared/ansi": ["../shared/src/ansi.ts"],
      "@iris/shared/billing": ["../shared/src/billing-types.ts"],
      "@iris/shared/color": ["../shared/src/color.ts"],
      "@iris/shared/i18n": ["../shared/src/i18n.ts"],
      "@iris/shared/translucency": ["../shared/src/translucency.ts"],
      "@iris/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src", "../shared/src"],
  "exclude": ["e2e", "electron", "playwright.config.ts"]
}
